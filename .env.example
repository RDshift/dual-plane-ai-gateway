GATEWAY_ENV=development
LOG_LEVEL=INFO
# Durable on-disk SQLite database for the sliding-window rate limiter.
# Relative paths resolve against the process working directory.
SQLITE_DB_PATH=data/gateway_ratelimit.db
RATE_LIMIT_TOKENS_PER_MINUTE=50000
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_TIMEOUT_MS=3000
STREAM_GUARDRAIL_MAX_HOLDBACK_CHARS=256
MCP_SERVER_SCRIPT=servers/customer_service_mcp.py
PRIMARY_MODEL_BASE_URL=https://api.primary-llm.internal/v1
PRIMARY_MODEL_API_KEY=sk-primary-placeholder
SECONDARY_MODEL_BASE_URL=https://api.secondary-llm.internal/v1
SECONDARY_MODEL_API_KEY=sk-secondary-placeholder
DEFAULT_MODEL_NAME=dual-plane-enterprise-default